#Sudoku Problem
# Sudoku grid size (9x9)
N = 9 
 
def printing(arr): 
    """ 
    This function prints the 9x9 Sudoku grid neatly in matrix form.
    """ 
    for i in range(N): 
        for j in range(N): 
            # A space is added after printing each number
            print(arr[i][j], end=" ") 
        # Move to a new line after each row
        print() 
 
 
def isSafe(grid, row, col, num): 
    """ 
    This function checks whether placing 'num' in the cell (row, col)
    follows the rules of Sudoku.
    """ 
    # 1. Check whether 'num' already exists in the same row
    for x in range(9): 
        if grid[row][x] == num: 
            return False 
 
    # 2. Check whether 'num' already exists in the same column
    for x in range(9): 
        if grid[x][col] == num: 
            return False 
 
    # 3. Check whether 'num' already exists in the specific 3x3 sub-grid
    startRow = row - row % 3 
    startCol = col - col % 3 
    for i in range(3): 
        for j in range(3): 
            if grid[i + startRow][j + startCol] == num: 
                return False 
 
    # If all three conditions are satisfied, it is safe to place the number
    return True 
 
 
def solveSudoku(grid, row, col): 
    """ 
    This is the main function that recursively solves the Sudoku
    using backtracking.
    """ 
    # Base condition: if we have passed the last column of the last row,
    # the entire Sudoku has been solved
    if (row == N - 1 and col == N): 
        return True 
 
    # If the column reaches 9, move to the first column of the next row
    if col == N: 
        row += 1 
        col = 0 
 
    # If the current cell already contains a value (greater than 0),
    # solve the next cell
    if grid[row][col] > 0: 
        return solveSudoku(grid, row, col + 1) 
 
    # If the cell is empty (0), try placing numbers from 1 to 9
    for num in range(1, N + 1, 1): 
         
        # Check whether it is safe to place 'num' in the current cell
        if isSafe(grid, row, col, num): 
             
            # If it is safe, place the number
            grid[row][col] = num 
 
            # Recursively try to solve the next cell
            if solveSudoku(grid, row, col + 1): 
                return True 
 
        # Backtracking: if placing this number does not lead to a solution,
        # reset the cell to 0 and try the next number (num + 1)
        grid[row][col] = 0 
 
    # If none of the numbers from 1 to 9 can be placed, return False
    return False 
 
 
# Initial Sudoku board (empty cells are represented by 0)
grid = [ 
    [3, 0, 6, 5, 0, 8, 4, 0, 0], 
    [5, 2, 0, 0, 0, 0, 0, 0, 0], 
    [0, 8, 7, 0, 0, 0, 0, 3, 1], 
    [0, 0, 3, 0, 1, 0, 0, 8, 0], 
    [9, 0, 0, 8, 6, 3, 0, 0, 5], 
    [0, 5, 0, 0, 9, 0, 6, 0, 0], 
    [1, 3, 0, 0, 0, 0, 2, 5, 0], 
    [0, 0, 0, 0, 0, 0, 0, 7, 4], 
    [0, 0, 5, 2, 0, 6, 3, 0, 0] 
] 
 
# Run the program and check whether the Sudoku can be solved
if (solveSudoku(grid, 0, 0)): 
    printing(grid)  # Print the solution if one is found
else: 
    print("no solution exists ")  # Print a message if no solution exists
